# Variables de la stack Portainer ROHAFYA (modèle).
# Dans Portainer : Stacks → rohafya → Environment variables → « Advanced mode », puis coller
# ce contenu complété. Ne jamais commiter la version remplie (deploy/stack.env est ignoré par git).
#
# Générer chaque secret avec :  openssl rand -hex 32

# --- Image -------------------------------------------------------------------
ROHAFYA_IMAGE=ghcr.io/manuelze/rohafya-api
# « latest » = dernière version de main ; préférer une version figée en production (ex. 1.0.0).
ROHAFYA_VERSION=latest
# Préfixe des conteneurs (rohafya-api, rohafya-db…) ; « rohafya-preprod » pour une 2e stack.
ROHAFYA_NOM=rohafya

# --- Secrets (obligatoires) --------------------------------------------------
# Lettres et chiffres uniquement (il entre dans une URL) : openssl rand -hex 24
POSTGRES_PASSWORD=
ROHAFYA_SECRET_KEY=
ROHAFYA_JWT_SECRET_KEY=
ROHAFYA_PASSWORD_SALT=

# --- E-mails -------------------------------------------------------------------
ROHAFYA_MAIL_SERVER=smtp.office365.com
ROHAFYA_MAIL_PORT=587
ROHAFYA_MAIL_USERNAME=eden.no-reply@pdmdsante.com
ROHAFYA_MAIL_PASSWORD=
# Expéditeur affiché : "PDMD - EDEN" <eden.no-reply@pdmdsante.com> par défaut. Pour le changer, utiliser
# le mode simple de Portainer (champ « value »), les guillemets passant mal en mode avancé.

# --- Front-end -----------------------------------------------------------------
# Adresse utilisée dans les QR codes et les e-mails.
ROHAFYA_FRONT_URL=https://rohafya.com
# Origines autorisées à appeler l'API (CORS), séparées par des virgules, sans « / » final.
ROHAFYA_FRONT_ORIGINS=https://rohafya.com,https://preprod.rohafya.com

# --- Fonctions optionnelles ------------------------------------------------------
ROHAFYA_PDF_IMPORT_ENABLED=false
ANTHROPIC_API_KEY=

# --- Réseau et ressources -------------------------------------------------------
# Nom du réseau Docker de Nginx Proxy Manager (voir la documentation, § 6.2).
NPM_NETWORK=npm_default
GUNICORN_WORKERS=3
API_MEMOIRE_MAX=1g
TZ=Africa/Douala

# --- Sauvegardes -----------------------------------------------------------------
SAUVEGARDE_PLANNING=@daily
SAUVEGARDE_JOURS=7
SAUVEGARDE_SEMAINES=4
SAUVEGARDE_MOIS=6
