            db.session.add(user)
            db.session.commit()
            return {"data" : user.to_dict(), "message" : "You have confirmed your account, Thanks"}
        else :
            return {"Message" : "The confirmation link is invalid or has expired."}
    return {"Message" : "Procédew à la confirmation Email"}


@auth.route('/inactive')
@login_required
def inactive():
    if current_user.is_confirmed:
        return {"data" : [current_user.email]}
    return {"message" : "Utilisateur Non Connecté"}

@auth.route('/resend_confirm')
