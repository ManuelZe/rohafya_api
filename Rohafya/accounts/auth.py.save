        first_name = request.get_json()['first_name']
        last_name = request.get_json()['last_name']
        role = request.get_json()['roles']

        error = None

        username = generate_random_letters()
        password = generate_random_letters_and_digits()

        while User.query.filter_by(username=username).first() is not None :
            username = generate_random_letters()
            #error = "Username Existe Déjà"
            #return {"message" : error}
        if not email :
            error = "Email is required."
            return {"message" : error}

        if Role.query.filter_by(name=role).first() != None:
            role = Role.query.filter_by(name=role).first()
            user = User(username=username, first_name=first_name, last_name=last_name, password=generate_password_hash(password), email=email)
            user.roles.append(role)
            if User.query.filter_by(email=email).first() is not None :
                error = "Email Existe Déjà"
                return {"message" : error}
            db.session.add(user)
            db.session.commit()

            #token = generate_token(user.email)

            #confirm_url = url_for("auth.confirm_email", token=token,  _external=True)
            #react_confirm_url = f"http://172.30.10.239:3000/confirm/{token}"
            #html = render_template("confirm_email.html", confirm_url=confirm_url)
            body = "Username : >>  "+username+" /Password >>  "+password
            subject = "Vos Identifiants"
            send_email(user.email, subject, body)
            login_user(user)
            print("Le current_user actuel ------------ ", user.username)

            user = User.query.filter_by(email=email).first()

            if user is not None :
                return jsonify(user.to_dict())

            return {"message" : "Aucun utilisateur Enregistré" }
        else :
            return {"message" : "Aucun Role ne corresponds à votre entrée"}

    return {"Message" : "Messsage"}


@auth.route('/user/verify-email/', methods=['POST'])
@cross_origin()
def verify_email():
    email = request.get_json()['email']

    user = User.query.filter(email=email).first()

    if user is not None :
        username = generate_random_letters()
        password = generate_random_letters_and_digits()

        user.username = username
        user.password = generate_password_hash(password)

        db.session.add(user)
        db.session.commit()

        body = "Username : >>  "+username+" /Password >>  "+password
        subject = "Vos Identifiants"
        send_email(user.email, subject, body)

        return {"Message" : "Email envoyé avec succès. "}

    else :
        return {"Message" : "L'EMAIL entré n'existe pas. "}


@auth.route('/user/login', methods=['GET', 'POST', 'OPTIONS'])
@cross_origin()
def login():
    if request.method == 'POST' :
        username = request.get_json()['username']
        password = request.get_json()['password']

        error = None
        user = User.query.filter_by(username=username).first()

        if username is None or user is None :
            error = "Username Incorrect, Veuillez Vérifier"
            return {"Username" : username, "message" : error}
        elif not check_password_hash(user.password, password):
            error = "Incorrect Password"
            return {"username" : username, "error" : error}

        if user :
            login_user(user)
            roles_data = [{'id': role.id, 'name': role.name} for role in current_user.roles]
            return {"Data" : [current_user.first_name, current_user.last_name], "Roles" : roles_data, "Message" : "Connexion Réussie"}
        else :
            return {"Message" : "Echec de la Connexion"}

    return {"Message" : "Essaie de Connexion"}


@auth.route("/user/all", methods=['GET'])
#@roles_required('Admin')
@cross_origin()
def all_user():
    users = User.query.all()
    users_list = [user.to_dict() for user in users]

    return jsonify(users_list)

@auth.route("/roles", methods=['GET'])
def all_roles():
    roles = Role.query.all()
    roles_list = [role.to_dict() for role in roles]

    return jsonify(roles_list)


@auth.route("/user/logout", methods=['GET', 'POST'])
@login_required
def logout():
    logout_user()
    print("Logout ? --- ", logout_user())
    return {"Message" : "Déconnexion Réussie"}

@auth.route('/confirm/<token>', methods=['GET', 'POST'])
@login_required
@cross_origin()
def confirm_email(token):
    if request.method == 'POST':
        if current_user.is_confirmed:
            return {"data" : [current_user.first_name, current_user.last_name, current_user.email]}

        email = confirm_token(token)
        user = User.query.filter_by(email=current_user.email).first_or_404()
